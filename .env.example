# ================================================================
# Manager PitStop — Variáveis de Desenvolvimento Local
# Copie para .env e preencha conforme necessário.
# Para produção, use .env.production.example como base.
# NUNCA commite .env ou .env.production no git.
# ================================================================

# ── BANCO DE DADOS (docker-compose.yml local) ─────────────────
DB_URL=jdbc:postgresql://localhost:5432/pitstop
DB_USERNAME=postgres
DB_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────
# Gere com: openssl rand -base64 64
JWT_SECRET=SUBSTITUA_POR_STRING_ALEATORIA_MIN_64_CHARS

# ── CRIPTOGRAFIA ──────────────────────────────────────────────
ENCRYPTION_MASTER_KEY=SUBSTITUA_POR_STRING_ALEATORIA_32_BYTES
ENCRYPTION_SALT=SUBSTITUA_POR_SALT_ALEATORIO

# ── CORS ──────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200

# ── ARMAZENAMENTO ─────────────────────────────────────────────
# Deixe em branco em dev — usa MinIO local via docker-compose
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_BUCKET=pitstop-docs
# STORAGE_ENDPOINT=http://localhost:9000   (MinIO local)

# ── STRIPE ────────────────────────────────────────────────────
# Deixe em branco para modo mock (sem chamada à API)
# Ou use chaves de TESTE: sk_test_... / whsec_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=

# ── FOCUS NFe ─────────────────────────────────────────────────
# Deixe em branco para modo mock (sem envio à prefeitura)
FOCUS_NFE_TOKEN=
FOCUS_NFE_API_URL=https://homologacao.focusnfe.com.br
NFE_MUNICIPIO_PRESTADOR=3550308

# ── DADOS FISCAIS DA PLATAFORMA (fallback de env) ─────────────
PLATFORM_FISCAL_CNPJ=
PLATFORM_FISCAL_RAZAO_SOCIAL=RiseCode Studio
PLATFORM_FISCAL_INSCRICAO_MUNICIPAL=
PLATFORM_FISCAL_CODIGO_MUNICIPIO=3550308
PLATFORM_FISCAL_CODIGO_SERVICO=
PLATFORM_FISCAL_ITEM_LISTA_SERVICO=1.01
PLATFORM_FISCAL_ALIQUOTA_ISS=2.00

# ── SMTP ──────────────────────────────────────────────────────
MAIL_ENABLED=false
WHATSAPP_ENABLED=false

# ── SEED ──────────────────────────────────────────────────────
SEED_TEST_USER=false
SEED_EMAIL=demo@managerpitstop.com.br
SEED_PASSWORD=
